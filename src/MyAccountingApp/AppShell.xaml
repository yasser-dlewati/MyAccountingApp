<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="MyAccountingApp.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:loc="clr-namespace:MyAccountingApp.Localization"
    xmlns:views="clr-namespace:MyAccountingApp.Views"
    Title="{loc:Translate App_Title}"
    FlyoutBehavior="Disabled">

    <!-- Bottom-nav root pages (Controls/BottomNavBar). Contacts / Categories / Settings are pushed from More. -->

    <FlyoutItem x:Name="DashboardItem" Title="{loc:Translate Nav_Dashboard}">
        <ShellContent ContentTemplate="{DataTemplate views:DashboardPage}" Route="dashboard" />
    </FlyoutItem>
    <FlyoutItem Title="{loc:Translate Nav_Orders}">
        <ShellContent ContentTemplate="{DataTemplate views:OrdersPage}" Route="orders" />
    </FlyoutItem>
    <FlyoutItem Title="{loc:Translate Nav_Inventory}">
        <ShellContent ContentTemplate="{DataTemplate views:ProductsPage}" Route="inventory" />
    </FlyoutItem>
    <FlyoutItem Title="{loc:Translate Nav_More}">
        <ShellContent ContentTemplate="{DataTemplate views:MorePage}" Route="more" />
    </FlyoutItem>

</Shell>
