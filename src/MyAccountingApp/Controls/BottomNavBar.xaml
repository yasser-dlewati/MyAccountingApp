<?xml version="1.0" encoding="utf-8" ?>
<!-- Bottom navigation for the main pages: Home, Invoices, [scan], Inventory, More + a raised barcode-scan button in the center.
     Row 0 is the space the scan button rises into (no background, so it shows the page behind). -->
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:loc="clr-namespace:MyAccountingApp.Localization"
             x:Class="MyAccountingApp.Controls.BottomNavBar">

    <ContentView.Resources>
        <Style x:Key="TabIcon" TargetType="Path">
            <Setter Property="Aspect" Value="Uniform" />
            <Setter Property="WidthRequest" Value="22" />
            <Setter Property="HeightRequest" Value="22" />
            <Setter Property="HorizontalOptions" Value="Center" />
        </Style>
        <Style x:Key="TabLabel" TargetType="Label">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="HorizontalTextAlignment" Value="Center" />
            <Setter Property="LineBreakMode" Value="TailTruncation" />
        </Style>
        <Style x:Key="Tab" TargetType="VerticalStackLayout">
            <Setter Property="Spacing" Value="2" />
            <Setter Property="VerticalOptions" Value="Center" />
            <Setter Property="Padding" Value="0,6" />
        </Style>
    </ContentView.Resources>

    <Grid RowDefinitions="18,62" ColumnDefinitions="*,*,80,*,*">
        <Border Grid.Row="1" Grid.ColumnSpan="5" StrokeThickness="0"
                BackgroundColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource Gray900}}" />
        <BoxView Grid.Row="1" Grid.ColumnSpan="5" HeightRequest="1" VerticalOptions="Start"
                 Color="{AppThemeBinding Light={StaticResource Gray100}, Dark={StaticResource Gray600}}" />

        <VerticalStackLayout x:Name="DashboardTab" Grid.Row="1" Grid.Column="0" Style="{StaticResource Tab}"
                             SemanticProperties.Description="{loc:Translate Nav_Dashboard}">
            <Path Style="{StaticResource TabIcon}"
                  Data="M10 20v-6h4v6h5v-8h3L12 3 2 12h3v8z" />
            <Label Text="{loc:Translate Nav_Dashboard}" Style="{StaticResource TabLabel}" />
            <VerticalStackLayout.GestureRecognizers>
                <TapGestureRecognizer Tapped="OnTabTapped" CommandParameter="dashboard" />
            </VerticalStackLayout.GestureRecognizers>
        </VerticalStackLayout>

        <VerticalStackLayout x:Name="OrdersTab" Grid.Row="1" Grid.Column="1" Style="{StaticResource Tab}"
                             SemanticProperties.Description="{loc:Translate Nav_Orders}">
            <Path Style="{StaticResource TabIcon}"
                  Data="M18 17H6v-2h12v2zm0-4H6v-2h12v2zm0-4H6V7h12v2zM3 22l1.5-1.5L6 22l1.5-1.5L9 22l1.5-1.5L12 22l1.5-1.5L15 22l1.5-1.5L18 22l1.5-1.5L21 22V2l-1.5 1.5L18 2l-1.5 1.5L15 2l-1.5 1.5L12 2l-1.5 1.5L9 2 7.5 3.5 6 2 4.5 3.5 3 2v20z" />
            <Label Text="{loc:Translate Nav_Orders}" Style="{StaticResource TabLabel}" />
            <VerticalStackLayout.GestureRecognizers>
                <TapGestureRecognizer Tapped="OnTabTapped" CommandParameter="orders" />
            </VerticalStackLayout.GestureRecognizers>
        </VerticalStackLayout>

        <!-- Center: barcode scanner (icon only; long press shows "Scan") -->
        <ImageButton Grid.RowSpan="2" Grid.Column="2" WidthRequest="56" HeightRequest="56" CornerRadius="28"
                     HorizontalOptions="Center" VerticalOptions="Start" Padding="13" BorderWidth="4"
                     BackgroundColor="{StaticResource Primary}" Source="ic_barcode.png"
                     BorderColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource Gray900}}"
                     ToolTipProperties.Text="{loc:Translate Scan_Button}"
                     SemanticProperties.Description="{loc:Translate Scan_Button}"
                     Clicked="OnScanClicked">
            <ImageButton.Shadow>
                <Shadow Brush="Black" Opacity="0.25" Radius="8" Offset="0,3" />
            </ImageButton.Shadow>
        </ImageButton>

        <VerticalStackLayout x:Name="InventoryTab" Grid.Row="1" Grid.Column="3" Style="{StaticResource Tab}"
                             SemanticProperties.Description="{loc:Translate Nav_Inventory}">
            <Path Style="{StaticResource TabIcon}"
                  Data="M20 2H4c-1 0-2 .9-2 2v3.01c0 .72.43 1.34 1 1.69V20c0 1.1 1.1 2 2 2h14c.9 0 2-.9 2-2V8.7c.57-.35 1-.97 1-1.69V4c0-1.1-1-2-2-2zm-5 12H9v-2h6v2zm5-7H4V4l16-.02V7z" />
            <Label Text="{loc:Translate Nav_Inventory}" Style="{StaticResource TabLabel}" />
            <VerticalStackLayout.GestureRecognizers>
                <TapGestureRecognizer Tapped="OnTabTapped" CommandParameter="inventory" />
            </VerticalStackLayout.GestureRecognizers>
        </VerticalStackLayout>

        <VerticalStackLayout x:Name="MoreTab" Grid.Row="1" Grid.Column="4" Style="{StaticResource Tab}"
                             SemanticProperties.Description="{loc:Translate Nav_More}">
            <Path Style="{StaticResource TabIcon}"
                  Data="M6 10c-1.1 0-2 .9-2 2s.9 2 2 2 2-.9 2-2-.9-2-2-2zm12 0c-1.1 0-2 .9-2 2s.9 2 2 2 2-.9 2-2-.9-2-2-2zm-6 0c-1.1 0-2 .9-2 2s.9 2 2 2 2-.9 2-2-.9-2-2-2z" />
            <Label Text="{loc:Translate Nav_More}" Style="{StaticResource TabLabel}" />
            <VerticalStackLayout.GestureRecognizers>
                <TapGestureRecognizer Tapped="OnTabTapped" CommandParameter="more" />
            </VerticalStackLayout.GestureRecognizers>
        </VerticalStackLayout>
    </Grid>
</ContentView>
