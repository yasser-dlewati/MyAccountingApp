<?xml version="1.0" encoding="utf-8"?>
<!-- Splash branding strip (Android 12+ branding image, max 200 x 80 dp; also used at the bottom of the pre-12 splash):
     "Created by" (splash_created_by, theme-colored), the YASDLE logo (Resources/Images/branding_on.svg) and
     the app version (splash_version, generated by Build/SplashVersion.targets). -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Fixes the intrinsic size at 200 x 80 dp. -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent" />
            <size android:width="200dp" android:height="80dp" />
        </shape>
    </item>
    <item android:gravity="top|center_horizontal" android:drawable="@drawable/splash_created_by" />
    <item android:top="17dp" android:width="38dp" android:height="46dp" android:gravity="top|center_horizontal" android:drawable="@drawable/branding_on" />
    <item android:gravity="bottom|center_horizontal" android:drawable="@drawable/splash_version" />
</layer-list>
