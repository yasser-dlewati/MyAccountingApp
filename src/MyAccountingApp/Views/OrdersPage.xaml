<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:loc="clr-namespace:MyAccountingApp.Localization"
             xmlns:vm="clr-namespace:MyAccountingApp.ViewModels"
             xmlns:controls="clr-namespace:MyAccountingApp.Controls"
             x:Class="MyAccountingApp.Views.OrdersPage"
             x:DataType="vm:OrdersViewModel"
             Title="{loc:Translate Nav_Orders}">

    <ContentPage.ToolbarItems>
        <ToolbarItem Text="{loc:Translate Common_Add}" IconImageSource="ic_add_circle.png" Command="{Binding AddCommand}" />
    </ContentPage.ToolbarItems>

    <Grid RowDefinitions="*,Auto">
        <Grid RowDefinitions="Auto,Auto,*" Padding="16,8" RowSpacing="4">
            <!-- Tabs: sales (+ returns) / purchases (+ returns) -->
            <Border StrokeShape="RoundRectangle 10" StrokeThickness="0" Padding="4"
                    BackgroundColor="{AppThemeBinding Light={StaticResource Gray50}, Dark={StaticResource Gray900}}">
                <Grid ColumnDefinitions="*,*" ColumnSpacing="4">
                    <Button Text="{loc:Translate Orders_SalesTab}" Style="{StaticResource TabButton}" Command="{Binding ShowSalesCommand}">
                        <Button.Triggers>
                            <DataTrigger TargetType="Button" Binding="{Binding IsSalesTab}" Value="True">
                                <Setter Property="BackgroundColor" Value="{StaticResource Primary}" />
                                <Setter Property="TextColor" Value="{StaticResource White}" />
                            </DataTrigger>
                        </Button.Triggers>
                    </Button>
                    <Button Grid.Column="1" Text="{loc:Translate Orders_PurchasesTab}" Style="{StaticResource TabButton}" Command="{Binding ShowPurchasesCommand}">
                        <Button.Triggers>
                            <DataTrigger TargetType="Button" Binding="{Binding IsPurchasesTab}" Value="True">
                                <Setter Property="BackgroundColor" Value="{StaticResource Primary}" />
                                <Setter Property="TextColor" Value="{StaticResource White}" />
                            </DataTrigger>
                        </Button.Triggers>
                    </Button>
                </Grid>
            </Border>
            <!-- Filters: collapsible card (search, status chips, date + time range); collapsed it shows a summary -->
            <Border Grid.Row="1" Style="{StaticResource Card}" Padding="12,6" Margin="0,4,0,0">
                <VerticalStackLayout Spacing="6">
                    <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="10" BackgroundColor="Transparent">
                        <Path Data="M10 18h4v-2h-4v2zM3 6v2h18V6H3zm3 7h12v-2H6v2z" Aspect="Uniform" WidthRequest="20" HeightRequest="20"
                              VerticalOptions="Center"
                              Fill="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}" />
                        <VerticalStackLayout Grid.Column="1" VerticalOptions="Center">
                            <Label Text="{loc:Translate Orders_Filters}" FontFamily="OpenSansSemibold" FontSize="14" />
                            <Label Text="{Binding FilterSummary}" Style="{StaticResource Caption}" LineBreakMode="TailTruncation" />
                        </VerticalStackLayout>
                        <Button Grid.Column="2" Text="{loc:Translate Orders_ClearFilters}" Style="{StaticResource SecondaryButton}"
                                Command="{Binding ClearFiltersCommand}" IsVisible="{Binding HasActiveFilters}"
                                Padding="12,0" HeightRequest="34" MinimumHeightRequest="34" FontSize="13" VerticalOptions="Center" />
                        <Path Grid.Column="3" Data="M7.41 8.59 12 13.17l4.59-4.58L18 10l-6 6-6-6z" Aspect="Uniform"
                              WidthRequest="14" HeightRequest="10" VerticalOptions="Center"
                              Fill="{AppThemeBinding Light={StaticResource Gray400}, Dark={StaticResource Gray300}}">
                            <Path.Triggers>
                                <DataTrigger TargetType="Path" Binding="{Binding FiltersExpanded}" Value="True">
                                    <Setter Property="Rotation" Value="180" />
                                </DataTrigger>
                            </Path.Triggers>
                        </Path>
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding ToggleFiltersCommand}" />
                        </Grid.GestureRecognizers>
                    </Grid>

                    <VerticalStackLayout IsVisible="{Binding FiltersExpanded}" Spacing="6" Padding="0,0,0,6">
                        <SearchBar Text="{Binding SearchText}" Placeholder="{loc:Translate Order_SearchHint}"
                                   SearchCommand="{Binding LoadCommand}" />
                        <controls:FilterChipBar ItemsSource="{Binding StatusChips}" Command="{Binding SelectStatusCommand}" />

                        <Grid ColumnDefinitions="*,Auto">
                            <Label Text="{loc:Translate Orders_DateFilter}" VerticalOptions="Center" />
                            <Switch Grid.Column="1" IsToggled="{Binding UseDateRange}" VerticalOptions="Center" />
                        </Grid>
                        <Grid IsVisible="{Binding UseDateRange}" ColumnDefinitions="Auto,*,Auto" RowDefinitions="Auto,Auto"
                              ColumnSpacing="8" RowSpacing="6">
                            <Label Text="{loc:Translate Orders_From}" Style="{StaticResource FormLabel}" Margin="0" VerticalOptions="Center" />
                            <DatePicker Grid.Column="1" Date="{Binding FromDate}" Format="yyyy-MM-dd" />
                            <TimePicker Grid.Column="2" Time="{Binding FromTime}" Format="HH:mm" WidthRequest="90" />
                            <Label Grid.Row="1" Text="{loc:Translate Orders_To}" Style="{StaticResource FormLabel}" Margin="0" VerticalOptions="Center" />
                            <DatePicker Grid.Row="1" Grid.Column="1" Date="{Binding ToDate}" Format="yyyy-MM-dd" />
                            <TimePicker Grid.Row="1" Grid.Column="2" Time="{Binding ToTime}" Format="HH:mm" WidthRequest="90" />
                        </Grid>
                        <Label Text="{loc:Translate Orders_DateRangeInvalid}" IsVisible="{Binding IsDateRangeInvalid}"
                               TextColor="IndianRed" FontSize="13" />
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </Border>

            <CollectionView Grid.Row="2" ItemsSource="{Binding Items}">
                <CollectionView.EmptyView>
                    <Label Text="{loc:Translate Common_Empty}" Style="{StaticResource Caption}" HorizontalOptions="Center" Margin="0,24" />
                </CollectionView.EmptyView>
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="vm:OrderRow">
                        <Border Style="{StaticResource Card}" Margin="0,4">
                            <Grid ColumnDefinitions="4,*,Auto" ColumnSpacing="10" RowDefinitions="Auto,Auto">
                                <BoxView Grid.RowSpan="2" Color="{Binding StatusColor}" CornerRadius="2" />
                                <Label Grid.Column="1" Text="{Binding Title}" Style="{StaticResource ItemTitle}" />
                                <Label Grid.Column="1" Grid.Row="1" Text="{Binding Subtitle}" Style="{StaticResource Caption}" />
                                <Label Grid.Column="2" Grid.RowSpan="2" Text="{Binding Total}" Style="{StaticResource Amount}" />
                            </Grid>
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer CommandParameter="{Binding .}"
                                    Command="{Binding Source={RelativeSource AncestorType={x:Type vm:OrdersViewModel}}, Path=OpenCommand, x:DataType=vm:OrdersViewModel}" />
                            </Border.GestureRecognizers>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </Grid>

        <controls:BottomNavBar Grid.Row="1" Current="orders" />
    </Grid>
</ContentPage>
