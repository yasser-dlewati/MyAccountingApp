<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:loc="clr-namespace:MyAccountingApp.Localization"
             xmlns:vm="clr-namespace:MyAccountingApp.ViewModels"
             x:Class="MyAccountingApp.Views.ProductEditPage"
             x:DataType="vm:ProductEditViewModel"
             Title="{Binding Title}">

    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="4">
            <Label Text="{loc:Translate Field_Name}" Style="{StaticResource FormLabel}" />
            <Entry Text="{Binding Name}" />
            <Label Text="{loc:Translate Field_Barcode}" Style="{StaticResource FormLabel}" />
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                <Entry Text="{Binding Barcode}" />
                <ImageButton Grid.Column="1" Source="ic_barcode.png" Style="{StaticResource IconButton}"
                             ToolTipProperties.Text="{loc:Translate Scan_Button}"
                             SemanticProperties.Description="{loc:Translate Scan_Button}"
                             Command="{Binding ScanBarcodeCommand}" />
            </Grid>
            <!-- Selling price | cost price (new: the opening unit cost; existing: the last cost, read-only) -->
            <Grid ColumnDefinitions="*,*" ColumnSpacing="8" RowDefinitions="Auto,Auto">
                <Label Text="{loc:Translate Field_Price}" Style="{StaticResource FormLabel}" />
                <Label Grid.Column="1" Text="{loc:Translate Product_CostPrice}" Style="{StaticResource FormLabel}" />
                <!-- Currency suffix inside the box, at its end side (left in Arabic); taps go through to the Entry -->
                <Grid Grid.Row="1">
                    <Entry Text="{Binding Price}" Keyboard="Numeric" />
                    <Label Text="{loc:Translate Currency_Symbol}" Style="{StaticResource InputSuffix}" />
                </Grid>
                <Grid Grid.Row="1" Grid.Column="1">
                    <Entry Text="{Binding OpeningCost}" Keyboard="Numeric" Placeholder="0" IsEnabled="{Binding IsNew}" />
                    <Label Text="{loc:Translate Currency_Symbol}" Style="{StaticResource InputSuffix}" />
                </Grid>
            </Grid>
            <Label Text="{loc:Translate Field_Category}" Style="{StaticResource FormLabel}" IsVisible="{Binding UseCategories}" />
            <Picker ItemsSource="{Binding Categories}" SelectedItem="{Binding Category}" IsVisible="{Binding UseCategories}" />
            <Label Text="{loc:Translate Field_DefaultSupplier}" Style="{StaticResource FormLabel}" />
            <Picker ItemsSource="{Binding Suppliers}" SelectedItem="{Binding DefaultSupplier}" />
            <!-- Status toggle | stock count (new: opening stock, editable; existing: stock on hand, read-only) -->
            <Grid ColumnDefinitions="*,*" ColumnSpacing="8" RowDefinitions="Auto,Auto">
                <Label Text="{loc:Translate Field_Status}" Style="{StaticResource FormLabel}" />
                <Label Grid.Column="1" Text="{Binding StockLabel}" Style="{StaticResource FormLabel}" />
                <HorizontalStackLayout Grid.Row="1" Spacing="8" VerticalOptions="Center">
                    <Switch IsToggled="{Binding IsActive}" VerticalOptions="Center" />
                    <Label Text="{loc:Translate Field_Active}" VerticalOptions="Center" />
                </HorizontalStackLayout>
                <Grid Grid.Row="1" Grid.Column="1">
                    <Entry Text="{Binding OpeningQuantity}" Keyboard="Numeric" Placeholder="0" IsEnabled="{Binding IsNew}" />
                    <Label Text="{loc:Translate Unit_Pieces}" Style="{StaticResource InputSuffix}" />
                </Grid>
            </Grid>
            <Label Text="{loc:Translate Product_OpeningStockHint}" Style="{StaticResource Caption}" IsVisible="{Binding IsNew}" />
            <Button Text="{loc:Translate Common_Save}" Command="{Binding SaveCommand}" Margin="0,8" />

            <VerticalStackLayout IsVisible="{Binding IsExisting}" Spacing="4">
                <Grid ColumnDefinitions="*,Auto" Margin="0,8,0,0">
                    <Label Text="{loc:Translate Product_Suppliers}" Style="{StaticResource SectionTitle}"
                           Margin="0" VerticalOptions="Center" />
                    <ImageButton Grid.Column="1" Source="ic_plus.png" Style="{StaticResource IconButton}"
                                 ToolTipProperties.Text="{loc:Translate Product_AddSupplier}"
                                 SemanticProperties.Description="{loc:Translate Product_AddSupplier}"
                                 Command="{Binding AddSupplierCommand}" />
                </Grid>
                <VerticalStackLayout BindableLayout.ItemsSource="{Binding SupplierCosts}">
                    <BindableLayout.EmptyView>
                        <Label Text="{loc:Translate Common_Empty}" Style="{StaticResource Caption}" />
                    </BindableLayout.EmptyView>
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="vm:SupplierCostRow">
                            <Border Style="{StaticResource Card}" Margin="0,4">
                                <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                                    <Label Text="{Binding Name}" VerticalOptions="Center" />
                                    <Label Grid.Column="1" Text="{Binding Cost}" Style="{StaticResource Amount}" />
                                    <Button Grid.Column="2" Text="✕" Style="{StaticResource SecondaryButton}" Padding="12,0"
                                            CommandParameter="{Binding .}"
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type vm:ProductEditViewModel}}, Path=RemoveSupplierCommand, x:DataType=vm:ProductEditViewModel}" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>
            </VerticalStackLayout>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
