<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:loc="clr-namespace:MyAccountingApp.Localization"
             xmlns:vm="clr-namespace:MyAccountingApp.ViewModels"
             xmlns:controls="clr-namespace:MyAccountingApp.Controls"
             x:Class="MyAccountingApp.Views.DashboardPage"
             x:DataType="vm:DashboardViewModel"
             Title="{loc:Translate Nav_Dashboard}">

    <Grid RowDefinitions="*,Auto,Auto">
        <RefreshView Command="{Binding LoadCommand}" IsRefreshing="{Binding IsBusy, Mode=OneWay}">
            <ScrollView>
                <VerticalStackLayout Padding="16" Spacing="12">
                    <Label Text="{loc:Translate Dashboard_Today}" Style="{StaticResource SectionTitle}" />
                    <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" ColumnSpacing="8" RowSpacing="8">
                        <Border Style="{StaticResource Card}">
                            <VerticalStackLayout>
                                <Label Text="{loc:Translate Dashboard_Sales}" Style="{StaticResource Caption}" />
                                <Label Text="{Binding TodayRevenue}" Style="{StaticResource KpiValue}" />
                            </VerticalStackLayout>
                        </Border>
                        <Border Grid.Column="1" Style="{StaticResource Card}">
                            <VerticalStackLayout>
                                <Label Text="{loc:Translate Dashboard_Profit}" Style="{StaticResource Caption}" />
                                <Label Text="{Binding TodayProfit}" Style="{StaticResource KpiValue}" />
                            </VerticalStackLayout>
                        </Border>
                        <Border Grid.Row="1" Style="{StaticResource Card}">
                            <VerticalStackLayout>
                                <Label Text="{loc:Translate Dashboard_Orders}" Style="{StaticResource Caption}" />
                                <Label Text="{Binding TodayOrders}" Style="{StaticResource KpiValue}" />
                            </VerticalStackLayout>
                        </Border>
                        <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource Card}">
                            <VerticalStackLayout>
                                <Label Text="{loc:Translate Dashboard_ItemsSold}" Style="{StaticResource Caption}" />
                                <Label Text="{Binding TodayItemsSold}" Style="{StaticResource KpiValue}" />
                            </VerticalStackLayout>
                        </Border>
                    </Grid>

                    <Label Text="{loc:Translate Dashboard_ThisMonth}" Style="{StaticResource SectionTitle}" />
                    <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" ColumnSpacing="8" RowSpacing="8">
                        <Border Style="{StaticResource Card}">
                            <VerticalStackLayout>
                                <Label Text="{loc:Translate Dashboard_Sales}" Style="{StaticResource Caption}" />
                                <Label Text="{Binding MonthRevenue}" Style="{StaticResource KpiValue}" />
                            </VerticalStackLayout>
                        </Border>
                        <Border Grid.Column="1" Style="{StaticResource Card}">
                            <VerticalStackLayout>
                                <Label Text="{loc:Translate Dashboard_Profit}" Style="{StaticResource Caption}" />
                                <Label Text="{Binding MonthProfit}" Style="{StaticResource KpiValue}" />
                            </VerticalStackLayout>
                        </Border>
                        <Border Grid.Row="1" Style="{StaticResource Card}">
                            <VerticalStackLayout>
                                <Label Text="{loc:Translate Dashboard_Orders}" Style="{StaticResource Caption}" />
                                <Label Text="{Binding MonthOrders}" Style="{StaticResource KpiValue}" />
                            </VerticalStackLayout>
                        </Border>
                        <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource Card}">
                            <VerticalStackLayout>
                                <Label Text="{loc:Translate Dashboard_ItemsSold}" Style="{StaticResource Caption}" />
                                <Label Text="{Binding MonthItemsSold}" Style="{StaticResource KpiValue}" />
                            </VerticalStackLayout>
                        </Border>
                    </Grid>

                    <Label Text="{loc:Translate Dashboard_LowStock}" Style="{StaticResource SectionTitle}" />
                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding LowStock}">
                        <BindableLayout.EmptyView>
                            <Label Text="{loc:Translate Common_Empty}" Style="{StaticResource Caption}" />
                        </BindableLayout.EmptyView>
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="vm:StockLine">
                                <Border Style="{StaticResource Card}" Margin="0,4">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <Label Text="{Binding Name}" VerticalOptions="Center" />
                                        <Label Grid.Column="1" Text="{Binding Quantity}" Style="{StaticResource Amount}">
                                            <Label.Triggers>
                                                <DataTrigger TargetType="Label" Binding="{Binding IsOutOfStock}" Value="True">
                                                    <Setter Property="TextColor" Value="IndianRed" />
                                                </DataTrigger>
                                            </Label.Triggers>
                                        </Label>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </ScrollView>
        </RefreshView>

        <Grid Grid.Row="1" ColumnDefinitions="*,*" ColumnSpacing="8" Padding="16,8,16,0">
            <Button Text="{loc:Translate Dashboard_NewSale}" Command="{Binding NewSaleCommand}" />
            <Button Grid.Column="1" Text="{loc:Translate Dashboard_NewPurchase}" Style="{StaticResource SecondaryButton}"
                    Command="{Binding NewPurchaseCommand}" />
        </Grid>

        <controls:BottomNavBar Grid.Row="2" Current="dashboard" />
    </Grid>
</ContentPage>
