<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:loc="clr-namespace:MyAccountingApp.Localization"
             xmlns:vm="clr-namespace:MyAccountingApp.ViewModels"
             xmlns:controls="clr-namespace:MyAccountingApp.Controls"
             x:Class="MyAccountingApp.Views.ProductsPage"
             x:DataType="vm:ProductsViewModel"
             Title="{loc:Translate Nav_Inventory}">

    <ContentPage.ToolbarItems>
        <!-- Scan: a known barcode shows the product (with Edit); an unknown one offers to add it as a new product. -->
        <ToolbarItem Text="{loc:Translate Scan_Button}" IconImageSource="ic_barcode_scan.png" Command="{Binding ScanCommand}" />
    </ContentPage.ToolbarItems>

    <Grid RowDefinitions="*,Auto">
        <Grid RowDefinitions="Auto,Auto,*" Padding="16,8" RowSpacing="4">
            <!-- Filters: collapsible card (search, stock, status, suppliers); collapsed it shows a summary -->
            <Border Style="{StaticResource Card}" Padding="12,6">
                <VerticalStackLayout Spacing="6">
                    <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="10" BackgroundColor="Transparent">
                        <Path Data="M10 18h4v-2h-4v2zM3 6v2h18V6H3zm3 7h12v-2H6v2z" Aspect="Uniform" WidthRequest="20" HeightRequest="20"
                              VerticalOptions="Center"
                              Fill="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}" />
                        <VerticalStackLayout Grid.Column="1" VerticalOptions="Center">
                            <Label Text="{loc:Translate Orders_Filters}" FontFamily="OpenSansSemibold" FontSize="14" />
                            <Label Text="{Binding FilterSummary}" Style="{StaticResource Caption}" LineBreakMode="TailTruncation" />
                        </VerticalStackLayout>
                        <ImageButton Grid.Column="2" Source="ic_reset.png" Style="{StaticResource SmallIconButton}"
                                     Command="{Binding ClearFiltersCommand}" IsVisible="{Binding HasActiveFilters}"
                                     ToolTipProperties.Text="{loc:Translate Orders_ClearFilters}"
                                     SemanticProperties.Description="{loc:Translate Orders_ClearFilters}" />
                        <Path Grid.Column="3" Data="M7.41 8.59 12 13.17l4.59-4.58L18 10l-6 6-6-6z" Aspect="Uniform"
                              WidthRequest="14" HeightRequest="10" VerticalOptions="Center"
                              Fill="{AppThemeBinding Light={StaticResource Gray400}, Dark={StaticResource Gray300}}">
                            <Path.Triggers>
                                <DataTrigger TargetType="Path" Binding="{Binding FiltersExpanded}" Value="True">
                                    <Setter Property="Rotation" Value="180" />
                                </DataTrigger>
                            </Path.Triggers>
                        </Path>
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding ToggleFiltersCommand}" />
                        </Grid.GestureRecognizers>
                    </Grid>

                    <VerticalStackLayout IsVisible="{Binding FiltersExpanded}" Spacing="6" Padding="0,0,0,6">
                        <SearchBar Text="{Binding SearchText}" Placeholder="{loc:Translate Product_SearchHint}"
                                   SearchCommand="{Binding LoadCommand}" />

                        <Label Text="{loc:Translate Products_StockFilter}" Style="{StaticResource FormLabel}" />
                        <controls:FilterChipBar ItemsSource="{Binding StockChips}" Command="{Binding SelectStockCommand}" />

                        <Label Text="{loc:Translate Products_StatusFilter}" Style="{StaticResource FormLabel}" IsVisible="{Binding ShowStatusFilter}" />
                        <controls:FilterChipBar ItemsSource="{Binding StatusChips}" Command="{Binding SelectStatusCommand}"
                                                IsVisible="{Binding ShowStatusFilter}" />

                        <Label Text="{loc:Translate Products_SupplierFilter}" Style="{StaticResource FormLabel}" />
                        <controls:FilterChipBar ItemsSource="{Binding SupplierChips}" Command="{Binding ToggleSupplierCommand}"
                                                IsVisible="{Binding HasSuppliers}" />
                        <Label Text="{loc:Translate Products_NoSuppliers}" Style="{StaticResource Caption}">
                            <Label.Triggers>
                                <DataTrigger TargetType="Label" Binding="{Binding HasSuppliers}" Value="True">
                                    <Setter Property="IsVisible" Value="False" />
                                </DataTrigger>
                            </Label.Triggers>
                        </Label>
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </Border>

            <Grid Grid.Row="1" ColumnDefinitions="*,Auto" Margin="0,4,0,0">
                <Label Text="{loc:Translate Stock_TotalValue}" Style="{StaticResource ItemTitle}" VerticalOptions="Center" />
                <Label Grid.Column="1" Text="{Binding TotalValue}" Style="{StaticResource KpiValue}" />
            </Grid>

            <CollectionView Grid.Row="2" ItemsSource="{Binding Items}">
                <CollectionView.EmptyView>
                    <Label Text="{loc:Translate Common_Empty}" Style="{StaticResource Caption}" HorizontalOptions="Center" Margin="0,24" />
                </CollectionView.EmptyView>
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="vm:ProductRow">
                        <Border Style="{StaticResource Card}" Margin="0,4" Opacity="{Binding Opacity}">
                            <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto">
                                <Label Text="{Binding Name}" Style="{StaticResource ItemTitle}" />
                                <Label Grid.Row="1" Text="{Binding Subtitle}" Style="{StaticResource Caption}" />
                                <Label Grid.Column="1" Text="{Binding Price}" Style="{StaticResource Amount}" />
                                <Label Grid.Column="1" Grid.Row="1" Style="{StaticResource Caption}" HorizontalOptions="End">
                                    <Label.FormattedText>
                                        <FormattedString>
                                            <Span Text="{loc:Translate Product_Stock}" />
                                            <Span Text=": " />
                                            <Span Text="{Binding Stock}" FontFamily="OpenSansSemibold" />
                                        </FormattedString>
                                    </Label.FormattedText>
                                    <Label.Triggers>
                                        <!-- Low (Settings → Inventory threshold) = amber; out of stock = red, which wins. -->
                                        <DataTrigger TargetType="Label" Binding="{Binding IsLowStock}" Value="True">
                                            <Setter Property="TextColor" Value="{AppThemeBinding Light=#E65100, Dark=#FFB74D}" />
                                        </DataTrigger>
                                        <DataTrigger TargetType="Label" Binding="{Binding IsOutOfStock}" Value="True">
                                            <Setter Property="TextColor" Value="IndianRed" />
                                        </DataTrigger>
                                    </Label.Triggers>
                                </Label>
                                <Label Grid.Row="2" Style="{StaticResource Caption}">
                                    <Label.FormattedText>
                                        <FormattedString>
                                            <Span Text="{loc:Translate Stock_LastCost}" />
                                            <Span Text=": " />
                                            <Span Text="{Binding LastCost}" />
                                        </FormattedString>
                                    </Label.FormattedText>
                                </Label>
                                <Label Grid.Row="2" Grid.Column="1" Text="{Binding Value}" Style="{StaticResource Caption}" HorizontalOptions="End" />
                            </Grid>
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer CommandParameter="{Binding .}"
                                    Command="{Binding Source={RelativeSource AncestorType={x:Type vm:ProductsViewModel}}, Path=OpenCommand, x:DataType=vm:ProductsViewModel}" />
                            </Border.GestureRecognizers>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </Grid>

        <controls:BottomNavBar Grid.Row="1" Current="inventory" />

        <controls:StoreLoader Grid.RowSpan="2" IsRunning="{Binding IsBusy}" />
    </Grid>
</ContentPage>
