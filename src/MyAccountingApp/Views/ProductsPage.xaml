<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:loc="clr-namespace:MyAccountingApp.Localization"
             xmlns:vm="clr-namespace:MyAccountingApp.ViewModels"
             xmlns:controls="clr-namespace:MyAccountingApp.Controls"
             x:Class="MyAccountingApp.Views.ProductsPage"
             x:DataType="vm:ProductsViewModel"
             Title="{loc:Translate Nav_Inventory}">

    <ContentPage.ToolbarItems>
        <ToolbarItem Text="{loc:Translate Common_Add}" IconImageSource="ic_add_circle.png" Command="{Binding AddCommand}" />
    </ContentPage.ToolbarItems>

    <Grid RowDefinitions="*,Auto">
        <Grid RowDefinitions="Auto,Auto,*" Padding="16,8" RowSpacing="4">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                <SearchBar Text="{Binding SearchText}" Placeholder="{loc:Translate Product_SearchHint}"
                           SearchCommand="{Binding LoadCommand}" />
                <ImageButton Grid.Column="1" Source="ic_barcode.png" Style="{StaticResource IconButton}"
                             ToolTipProperties.Text="{loc:Translate Scan_Button}"
                             SemanticProperties.Description="{loc:Translate Scan_Button}"
                             Command="{Binding ScanCommand}" />
            </Grid>
            <Grid Grid.Row="1" ColumnDefinitions="*,Auto">
                <Label Text="{loc:Translate Stock_TotalValue}" Style="{StaticResource ItemTitle}" VerticalOptions="Center" />
                <Label Grid.Column="1" Text="{Binding TotalValue}" Style="{StaticResource KpiValue}" />
            </Grid>

            <CollectionView Grid.Row="2" ItemsSource="{Binding Items}">
                <CollectionView.EmptyView>
                    <Label Text="{loc:Translate Common_Empty}" Style="{StaticResource Caption}" HorizontalOptions="Center" Margin="0,24" />
                </CollectionView.EmptyView>
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="vm:ProductRow">
                        <Border Style="{StaticResource Card}" Margin="0,4" Opacity="{Binding Opacity}">
                            <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto">
                                <Label Text="{Binding Name}" Style="{StaticResource ItemTitle}" />
                                <Label Grid.Row="1" Text="{Binding Subtitle}" Style="{StaticResource Caption}" />
                                <Label Grid.Column="1" Text="{Binding Price}" Style="{StaticResource Amount}" />
                                <Label Grid.Column="1" Grid.Row="1" Style="{StaticResource Caption}" HorizontalOptions="End">
                                    <Label.FormattedText>
                                        <FormattedString>
                                            <Span Text="{loc:Translate Product_Stock}" />
                                            <Span Text=": " />
                                            <Span Text="{Binding Stock}" FontFamily="OpenSansSemibold" />
                                        </FormattedString>
                                    </Label.FormattedText>
                                    <Label.Triggers>
                                        <!-- Low (Settings → Inventory threshold) = amber; out of stock = red, which wins. -->
                                        <DataTrigger TargetType="Label" Binding="{Binding IsLowStock}" Value="True">
                                            <Setter Property="TextColor" Value="{AppThemeBinding Light=#E65100, Dark=#FFB74D}" />
                                        </DataTrigger>
                                        <DataTrigger TargetType="Label" Binding="{Binding IsOutOfStock}" Value="True">
                                            <Setter Property="TextColor" Value="IndianRed" />
                                        </DataTrigger>
                                    </Label.Triggers>
                                </Label>
                                <Label Grid.Row="2" Style="{StaticResource Caption}">
                                    <Label.FormattedText>
                                        <FormattedString>
                                            <Span Text="{loc:Translate Stock_LastCost}" />
                                            <Span Text=": " />
                                            <Span Text="{Binding LastCost}" />
                                        </FormattedString>
                                    </Label.FormattedText>
                                </Label>
                                <Label Grid.Row="2" Grid.Column="1" Text="{Binding Value}" Style="{StaticResource Caption}" HorizontalOptions="End" />
                            </Grid>
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer CommandParameter="{Binding .}"
                                    Command="{Binding Source={RelativeSource AncestorType={x:Type vm:ProductsViewModel}}, Path=OpenCommand, x:DataType=vm:ProductsViewModel}" />
                            </Border.GestureRecognizers>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </Grid>

        <controls:BottomNavBar Grid.Row="1" Current="inventory" />

        <controls:StoreLoader Grid.RowSpan="2" IsRunning="{Binding IsBusy}" />
    </Grid>
</ContentPage>
