<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:loc="clr-namespace:MyAccountingApp.Localization"
             xmlns:vm="clr-namespace:MyAccountingApp.ViewModels"
             x:Class="MyAccountingApp.Views.ContactsPage"
             x:DataType="vm:ContactsViewModel"
             Title="{loc:Translate Nav_Contacts}">

    <ContentPage.ToolbarItems>
        <ToolbarItem Text="{loc:Translate Common_Add}" Command="{Binding AddCommand}" />
    </ContentPage.ToolbarItems>

    <Grid RowDefinitions="Auto,Auto,*" Padding="16,8" RowSpacing="4">
        <SearchBar Text="{Binding SearchText}" Placeholder="{loc:Translate Common_Search}"
                   SearchCommand="{Binding LoadCommand}" />
        <Grid Grid.Row="1" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
            <Picker ItemsSource="{Binding RoleOptions}" SelectedItem="{Binding RoleFilter}" />
            <Switch Grid.Column="1" IsToggled="{Binding ShowInactive}" VerticalOptions="Center" />
            <Label Grid.Column="2" Text="{loc:Translate Common_ShowInactive}" VerticalOptions="Center" />
        </Grid>

        <CollectionView Grid.Row="2" ItemsSource="{Binding Items}">
            <CollectionView.EmptyView>
                <Label Text="{loc:Translate Common_Empty}" Style="{StaticResource Caption}" HorizontalOptions="Center" Margin="0,24" />
            </CollectionView.EmptyView>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="vm:ContactRow">
                    <Border Style="{StaticResource Card}" Margin="0,4" Opacity="{Binding Opacity}">
                        <VerticalStackLayout>
                            <Label Text="{Binding Contact.Name}" Style="{StaticResource ItemTitle}" />
                            <Label Text="{Binding Subtitle}" Style="{StaticResource Caption}" />
                        </VerticalStackLayout>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer CommandParameter="{Binding .}"
                                Command="{Binding Source={RelativeSource AncestorType={x:Type vm:ContactsViewModel}}, Path=OpenCommand, x:DataType=vm:ContactsViewModel}" />
                        </Border.GestureRecognizers>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentPage>
