<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:loc="clr-namespace:MyAccountingApp.Localization"
             xmlns:vm="clr-namespace:MyAccountingApp.ViewModels"
             x:Class="MyAccountingApp.Views.SettingsPage"
             x:DataType="vm:SettingsViewModel"
             Title="{loc:Translate Nav_Settings}">

    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="8">
            <Label Text="{loc:Translate Settings_Language}" Style="{StaticResource SectionTitle}" />
            <Picker ItemsSource="{Binding LanguageOptions}" SelectedItem="{Binding Language}" />

            <Label Text="{loc:Translate Settings_Data}" Style="{StaticResource SectionTitle}" />
            <Label Text="{loc:Translate Settings_DataHint}" Style="{StaticResource Caption}" />
            <Button Text="{loc:Translate Settings_Backup}" Command="{Binding BackupCommand}" />
            <Button Text="{loc:Translate Settings_Restore}" Style="{StaticResource SecondaryButton}" Command="{Binding RestoreCommand}" />

            <Label Text="{Binding AppVersion, StringFormat='v{0}'}" Style="{StaticResource Caption}" HorizontalOptions="Center" Margin="0,24" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
