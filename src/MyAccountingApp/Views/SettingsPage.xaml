<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:loc="clr-namespace:MyAccountingApp.Localization"
             xmlns:vm="clr-namespace:MyAccountingApp.ViewModels"
             x:Class="MyAccountingApp.Views.SettingsPage"
             x:DataType="vm:SettingsViewModel"
             Title="{loc:Translate Nav_Settings}">

    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="8">
            <Label Text="{loc:Translate Settings_Language}" Style="{StaticResource SectionTitle}" />
            <Picker ItemsSource="{Binding LanguageOptions}" SelectedItem="{Binding Language}" />

            <Label Text="{loc:Translate Settings_Theme}" Style="{StaticResource SectionTitle}" />
            <Picker ItemsSource="{Binding ThemeOptions}" SelectedItem="{Binding Theme}" />

            <Label Text="{loc:Translate Settings_General}" Style="{StaticResource SectionTitle}" />
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                <Label Text="{loc:Translate Settings_ConfirmExit}" VerticalOptions="Center" />
                <Switch Grid.Column="1" IsToggled="{Binding ConfirmExit}" VerticalOptions="Center" />
            </Grid>
            <Label Text="{loc:Translate Settings_ConfirmExitHint}" Style="{StaticResource Caption}" />

            <Label Text="{loc:Translate Settings_Products}" Style="{StaticResource SectionTitle}" />
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                <Label Text="{loc:Translate Settings_ShowInactiveProducts}" VerticalOptions="Center" />
                <Switch Grid.Column="1" IsToggled="{Binding ShowInactiveProducts}" VerticalOptions="Center" />
            </Grid>

            <Label Text="{loc:Translate Settings_Categories}" Style="{StaticResource SectionTitle}" />
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                <Label Text="{loc:Translate Settings_UseCategories}" VerticalOptions="Center" />
                <Switch Grid.Column="1" IsToggled="{Binding UseCategories}" VerticalOptions="Center" />
            </Grid>
            <Label Text="{loc:Translate Settings_UseCategoriesHint}" Style="{StaticResource Caption}" />

            <Label Text="{loc:Translate Settings_WalkIn}" Style="{StaticResource SectionTitle}" />
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                <Label Text="{loc:Translate Settings_RequireCustomer}" VerticalOptions="Center" />
                <Switch Grid.Column="1" IsToggled="{Binding RequireCustomer}" VerticalOptions="Center" />
            </Grid>
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                <Label Text="{loc:Translate Settings_RequireSupplier}" VerticalOptions="Center" />
                <Switch Grid.Column="1" IsToggled="{Binding RequireSupplier}" VerticalOptions="Center" />
            </Grid>
            <Label Text="{loc:Translate Settings_WalkInHint}" Style="{StaticResource Caption}" />

            <Label Text="{loc:Translate Settings_Data}" Style="{StaticResource SectionTitle}" />
            <Label Text="{loc:Translate Settings_DataHint}" Style="{StaticResource Caption}" />
            <Button Text="{loc:Translate Settings_Backup}" Command="{Binding BackupCommand}" />
            <Button Text="{loc:Translate Settings_Restore}" Style="{StaticResource SecondaryButton}" Command="{Binding RestoreCommand}" />
            <Button Text="{loc:Translate Settings_ShareLogs}" Style="{StaticResource SecondaryButton}" Command="{Binding ShareLogsCommand}" />
            <Label Text="{loc:Translate Settings_ShareLogsHint}" Style="{StaticResource Caption}" />

            <Label Text="{loc:Translate Settings_About}" Style="{StaticResource SectionTitle}" />
            <Border Style="{StaticResource Card}">
                <VerticalStackLayout Spacing="6" HorizontalOptions="Center">
                    <Label Text="{loc:Translate App_Title}" Style="{StaticResource ItemTitle}" HorizontalOptions="Center" />
                    <Label Text="{Binding AppVersion, StringFormat='v{0}'}" Style="{StaticResource Caption}" HorizontalOptions="Center" />
                    <Label Text="{loc:Translate About_CreatedBy}" Style="{StaticResource Caption}" HorizontalOptions="Center" Margin="0,8,0,0" />
                    <Image Source="yasdle.png" HeightRequest="96" WidthRequest="79" HorizontalOptions="Center" />
                </VerticalStackLayout>
            </Border>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
